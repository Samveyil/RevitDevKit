<UserControl x:Class="RevitDevKit.UI.Console.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RevitDevKit.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RevitDevKit.UI.Console"
             d:DataContext="{d:DesignInstance local:ConsoleVM}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/EditorScrollBars.xaml" />
    </UserControl.Resources>

    <!-- Framed as the editor's tab above it: an orange frame, the toolbar on a gray strip like the tab header, then the output.
         As in the editor, the frame is drawn over the content, 1 inside it: the square corners of the scroll bars stay
         under its rounded ones instead of sticking out over them. -->
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <DockPanel Margin="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource SelectedTabBrush}" CornerRadius="3 3 0 0" Padding="6 3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static loc:ConsoleStrings.Title}" VerticalAlignment="Center"/>

                    <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding ClearCommand}"
                            Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ConsoleStrings.ClearToolTip}">
                        <materialDesign:PackIcon Kind="Broom" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
                    </Button>

                    <Button Width="22" Height="22" Margin="8 0 0 0" Padding="0" VerticalAlignment="Center" Click="OnCopy"
                            Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ConsoleStrings.CopyToolTip}">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="22" Height="22" Foreground="{DynamicResource IconBrush}"/>
                    </Button>

                    <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding ClearShownCommand}"
                            Style="{DynamicResource MaterialDesignFlatButton}"
                            ToolTip="{x:Static loc:ConsoleStrings.ClearShownToolTip}">
                        <materialDesign:PackIcon Kind="VectorSquareRemove" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
                    </Button>

                    <!-- When a run from Add-in Explorer or Repeat Last opens the console pane: a bell that shows the choice,
                         with its menu, which closes on a choice. Only in the pane (HasPaneOpening): Script Editor's console has no use for it. -->
                    <materialDesign:PopupBox x:Name="PaneOpening" Margin="8 0 0 0" VerticalAlignment="Center"
                                             ToolTip="{Binding OpenPaneToolTip}">
                        <materialDesign:PopupBox.ToggleContent>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding OpenPaneIcon}" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
                                <materialDesign:PackIcon Kind="MenuDown" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource IconBrush}"/>
                            </StackPanel>
                        </materialDesign:PopupBox.ToggleContent>

                            <StackPanel Margin="12 8">
                                <TextBlock Text="{x:Static loc:ConsoleStrings.OpenPaneHeader}" Opacity="0.7" Margin="0 0 0 6"/>
                                <RadioButton Content="{x:Static loc:ConsoleStrings.OpenOnProblems}" Padding="4 0" GroupName="OpenPane" IsChecked="{Binding IsOpenOnProblems}"
                                             ToolTip="{x:Static loc:ConsoleStrings.OpenOnProblemsToolTip}"/>
                                <RadioButton Content="{x:Static loc:ConsoleStrings.OpenOnOutput}" Margin="0 8 0 0" Padding="4 0" GroupName="OpenPane" IsChecked="{Binding IsOpenOnOutput}"
                                             ToolTip="{x:Static loc:ConsoleStrings.OpenOnOutputToolTip}"/>
                                <RadioButton Content="{x:Static loc:ConsoleStrings.OpenAlways}" Margin="0 8 0 0" Padding="4 0" GroupName="OpenPane" IsChecked="{Binding IsOpenAlways}"/>
                                <RadioButton Content="{x:Static loc:ConsoleStrings.OpenNever}" Margin="0 8 0 0" Padding="4 0" GroupName="OpenPane" IsChecked="{Binding IsOpenNever}"
                                             ToolTip="{x:Static loc:ConsoleStrings.OpenNeverToolTip}"/>
                            </StackPanel>
                    </materialDesign:PopupBox>

                    <Border Style="{DynamicResource ToolbarSeparator}"/>

                    <!-- What a run from DevKit does with the console: one setting for Script Editor and Add-in Explorer. -->
                    <CheckBox Content="{x:Static loc:ConsoleStrings.ClearOnRun}" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsClearOnRun}"
                              ToolTip="{x:Static loc:ConsoleStrings.ClearOnRunToolTip}"/>
                    <CheckBox Content="{x:Static loc:ConsoleStrings.ClearShownOnRun}" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsClearShownOnRun}"
                              ToolTip="{x:Static loc:ConsoleStrings.ClearShownOnRunToolTip}"/>
                    <CheckBox Content="{x:Static loc:ConsoleStrings.HideWarnings}" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsHideWarnings}"
                              ToolTip="{x:Static loc:ConsoleStrings.HideWarningsToolTip}"/>


                    <Border Style="{DynamicResource ToolbarSeparator}"/>

                    <!-- How the console shows its output. The console pane has room for the checkboxes; Script Editor puts them
                         in a menu (IsViewMenu), framed as the Examples menu there, so its header stays one short row. -->
                    <StackPanel x:Name="ViewInline" Orientation="Horizontal">
                        <CheckBox Content="{x:Static loc:ConsoleStrings.AutoScroll}" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsAutoScroll}" ToolTip="{x:Static loc:ConsoleStrings.AutoScrollToolTip}"/>
                        <CheckBox Content="{x:Static loc:ConsoleStrings.Timestamps}" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsTimestamps}" ToolTip="{x:Static loc:ConsoleStrings.TimestampsToolTip}"/>
                        <CheckBox Content="{x:Static loc:ConsoleStrings.ShowDebug}" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsShowDebug}" ToolTip="{x:Static loc:ConsoleStrings.ShowDebugToolTip}"/>
                    </StackPanel>

                    <Border x:Name="ViewMenu" Visibility="Collapsed" Height="23" BorderThickness="1" BorderBrush="{DynamicResource BIMPlugins.PrimaryBrush}" CornerRadius="3" VerticalAlignment="Center">
                        <materialDesign:PopupBox x:Name="ViewOptions" StaysOpen="True" VerticalAlignment="Stretch" ToolTip="{x:Static loc:ConsoleStrings.ViewMenuToolTip}">
                            <materialDesign:PopupBox.ToggleContent>
                                <TextBlock Text="{x:Static loc:ConsoleStrings.ViewMenu}" Margin="10 0 8 0" VerticalAlignment="Center"/>
                            </materialDesign:PopupBox.ToggleContent>

                            <StackPanel Margin="12 8">
                                <CheckBox Content="{x:Static loc:ConsoleStrings.AutoScroll}" Padding="4 0" IsChecked="{Binding IsAutoScroll}"
                                          ToolTip="{x:Static loc:ConsoleStrings.AutoScrollToolTip}"/>
                                <CheckBox Content="{x:Static loc:ConsoleStrings.Timestamps}" Margin="0 8 0 0" Padding="4 0" IsChecked="{Binding IsTimestamps}"
                                          ToolTip="{x:Static loc:ConsoleStrings.TimestampsToolTip}"/>
                                <CheckBox Content="{x:Static loc:ConsoleStrings.ShowDebug}" Margin="0 8 0 0" Padding="4 0" IsChecked="{Binding IsShowDebug}"
                                          ToolTip="{x:Static loc:ConsoleStrings.ShowDebugToolTip}"/>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- The frame is the console's, so the output has none of its own. -->
            <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Consolas"
                         Style="{x:Null}" BorderThickness="0" Background="Transparent" Padding="6 4"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>

        <Border BorderThickness="1" BorderBrush="{DynamicResource BIMPlugins.PrimaryBrush}" CornerRadius="4" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
