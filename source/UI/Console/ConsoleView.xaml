<UserControl x:Class="RevitDevKit.UI.Console.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RevitDevKit.UI.Console"
             d:DataContext="{d:DesignInstance local:ConsoleVM}"
             mc:Ignorable="d">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Консоль" VerticalAlignment="Center"/>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding ClearCommand}"
                    Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="Очистить консоль (Ctrl+L)">
                <materialDesign:PackIcon Kind="Broom" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
            </Button>

            <Button Width="22" Height="22" Margin="8 0 0 0" Padding="0" VerticalAlignment="Center" Click="OnCopy"
                    Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="Скопировать весь вывод в буфер обмена">
                <materialDesign:PackIcon Kind="ContentCopy" Width="22" Height="22" Foreground="{DynamicResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding ClearShownCommand}"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    ToolTip="Очистить виды от нарисованного">
                <materialDesign:PackIcon Kind="VectorSquareRemove" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
            </Button>

            <Border Style="{DynamicResource ToolbarSeparator}"/>

            <!-- What a run from DevKit does with the console: one setting for Script Editor and Add-in Explorer. -->
            <CheckBox Content="Чистить консоль" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsClearOnRun}"
                      ToolTip="Очищать консоль перед каждым запуском"/>
            <CheckBox Content="Чистить виды" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsClearShownOnRun}"
                      ToolTip="Стирать с видов нарисованное перед каждым запуском"/>
            <CheckBox Content="Тихий режим" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsHideWarnings}"
                      ToolTip="Предупреждения Revit — только в консоль, без окон"/>

            <Border Style="{DynamicResource ToolbarSeparator}"/>

            <!-- How the console shows its output. The console pane has room for the checkboxes; Script Editor puts them
                 in a menu (IsViewMenu), framed as Примеры there, so its header stays one short row. -->
            <StackPanel x:Name="ViewInline" Orientation="Horizontal">
                <CheckBox Content="Автопрокрутка" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsAutoScroll}" ToolTip="Прокручивать консоль к новому выводу"/>
                <CheckBox Content="Время" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsTimestamps}" ToolTip="Начинать строки со времени"/>
                <CheckBox Content="Стек вызовов" VerticalAlignment="Center" Margin="12 0 0 0" Padding="2 0" IsChecked="{Binding IsShowDebug}" ToolTip="Показывать стеки вызовов"/>
            </StackPanel>

            <Border x:Name="ViewMenu" Visibility="Collapsed" Height="23" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="3" VerticalAlignment="Center">
                <materialDesign:PopupBox x:Name="ViewOptions" StaysOpen="True" VerticalAlignment="Stretch" ToolTip="Как консоль показывает вывод">
                    <materialDesign:PopupBox.ToggleContent>
                        <TextBlock Text="Вид ▾" Margin="10 0 8 0" VerticalAlignment="Center"/>
                    </materialDesign:PopupBox.ToggleContent>

                    <StackPanel Margin="12 8">
                        <CheckBox Content="Автопрокрутка" Padding="4 0" IsChecked="{Binding IsAutoScroll}"
                                  ToolTip="Прокручивать консоль к новому выводу"/>
                        <CheckBox Content="Время" Margin="0 8 0 0" Padding="4 0" IsChecked="{Binding IsTimestamps}"
                                  ToolTip="Начинать строки со времени"/>
                        <CheckBox Content="Стек вызовов" Margin="0 8 0 0" Padding="4 0" IsChecked="{Binding IsShowDebug}"
                                  ToolTip="Показывать стеки вызовов"/>
                    </StackPanel>
                </materialDesign:PopupBox>
            </Border>
        </StackPanel>

        <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Consolas" Margin="0 2 0 0"
                     Style="{DynamicResource MaterialDesignOutlinedRichTextBox}" VerticalContentAlignment="Stretch" Padding="6 4" BorderBrush="{DynamicResource AccentBrush}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</UserControl>
