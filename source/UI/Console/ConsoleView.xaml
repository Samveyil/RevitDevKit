<UserControl x:Class="RevitDevKit.UI.Console.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:RevitDevKit.UI.Console"
             d:DataContext="{d:DesignInstance local:ConsoleVM}"
             mc:Ignorable="d">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Консоль" VerticalAlignment="Center"/>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding ClearCommand}"
                    Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="Очистить консоль (Ctrl+L)">
                <materialDesign:PackIcon Kind="Broom" Width="25" Height="25" Foreground="{DynamicResource IconBrush}"/>
            </Button>

            <Button Width="22" Height="22" Margin="10 0" Padding="0" VerticalAlignment="Center" Click="OnCopy"
                    Style="{DynamicResource MaterialDesignFlatButton}" ToolTip="Скопировать весь вывод в буфер обмена">
                <materialDesign:PackIcon Kind="ContentCopy" Width="22" Height="22" Foreground="{DynamicResource IconBrush}"/>
            </Button>

            <CheckBox Content="Автопрокрутка" VerticalAlignment="Center" Margin="15 0 0 0" Padding="2 0" IsChecked="{Binding IsAutoScroll}"/>
            <CheckBox Content="Время" VerticalAlignment="Center" Margin="10 0" Padding="2 0" IsChecked="{Binding IsTimestamps}"/>
            <CheckBox Content="Стек вызовов" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsShowDebug}"/>
        </StackPanel>

        <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Consolas" Margin="0 2 0 0"
                     Style="{DynamicResource MaterialDesignOutlinedRichTextBox}" VerticalContentAlignment="Top" Padding="6 4" BorderBrush="{DynamicResource AccentBrush}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</UserControl>
