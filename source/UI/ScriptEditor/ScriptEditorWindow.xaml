<Window x:Class="RevitDevKit.UI.ScriptEditor.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RevitDevKit.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitDevKit.UI.ScriptEditor"
        xmlns:console="clr-namespace:RevitDevKit.UI.Console"
        d:DataContext="{d:DesignInstance local:ScriptEditorVM}"
        mc:Ignorable="d"
        Title="Script Editor" WindowStartupLocation="CenterScreen"
        Height="800" Width="820" MinHeight="480" MinWidth="820">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/EditorScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunCommand}"/>
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunWithDebuggerCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveFileAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding Output.ClearCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="{x:Static loc:ScriptEditorStrings.RunToolTip}" >
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ScriptEditorStrings.Run}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding RunWithDebuggerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="{x:Static loc:ScriptEditorStrings.DebugToolTip}">
                <materialDesign:PackIcon Kind="BugPlayOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding NewTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ScriptEditorStrings.NewTabToolTip}">
                <materialDesign:PackIcon Kind="FileCodeOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding OpenFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ScriptEditorStrings.OpenToolTip}">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding SaveFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ScriptEditorStrings.SaveToolTip}">
                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding SaveFileAsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ScriptEditorStrings.SaveAsToolTip}">
                <materialDesign:PackIcon Kind="ContentSaveEditOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Border BorderThickness="1" BorderBrush="{StaticResource BIMPlugins.PrimaryBrush}" CornerRadius="3">
                <materialDesign:PopupBox ToolTip="{x:Static loc:ScriptEditorStrings.SamplesToolTip}">
                    <materialDesign:PopupBox.ToggleContent>
                        <TextBlock Text="{x:Static loc:ScriptEditorStrings.Samples}" Margin="10 0 5 0" />
                    </materialDesign:PopupBox.ToggleContent>

                    <ItemsControl ItemsSource="{Binding CodeSamples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Command="{Binding DataContext.SampleSelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </materialDesign:PopupBox>
            </Border>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="{x:Static loc:ScriptEditorStrings.AutoTransaction}" IsChecked="{Binding IsAutoTransaction}"
                      ToolTip="{x:Static loc:ScriptEditorStrings.AutoTransactionToolTip}"/>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <!-- On its own, apart from the run and file groups: instructions for an AI chat on how to write scripts for Script Editor (AiInstructions), as a split button:
                 the icon repeats the copy chosen last, the arrow opens both, and the one chosen there becomes the icon's. -->
            <!-- One frame round the icon and the arrow, with a line between them, like Revit's split buttons: shown while the mouse is
                 over either part or the list is open, so at rest the button is a plain icon like its neighbours. -->
            <Border BorderThickness="1" CornerRadius="3" Height="25" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BIMPlugins.PrimaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPopupOpen, ElementName=AiPopup}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BIMPlugins.PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Button Width="27" Height="23" Padding="0" Command="{Binding RepeatAiCopyCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{Binding AiButtonToolTip}"
                            materialDesign:ButtonAssist.CornerRadius="2 0 0 2">
                        <Grid>
                            <materialDesign:PackIcon Kind="{Binding AiButtonIcon}" Width="20" Height="20" Foreground="{StaticResource IconBrush}"/>
                            <!-- The detailed instructions are on: the icon copies them. -->
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 -2 0" Fill="{StaticResource BIMPlugins.PrimaryBrush}"
                                     Visibility="{Binding IsAiDetailed, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Button>

                    <Border Width="1" Background="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>

                    <materialDesign:PopupBox x:Name="AiPopup" StaysOpen="True" ToolTip="{x:Static loc:ScriptEditorStrings.AiMenuToolTip}" VerticalAlignment="Center" Padding="0">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon Kind="MenuDown" Width="16" Height="16" Margin="1 0" Foreground="{StaticResource IconBrush}"/>
                        </materialDesign:PopupBox.ToggleContent>

                        <!-- Compact, as a toolbar menu: one line per item. -->
                        <StackPanel Margin="0 2">
                            <StackPanel.Resources>
                                <!-- A plain menu row: MaterialDesign's popup items are at least 48 high. -->
                                <Style x:Key="AiMenuItem" TargetType="Button">
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="Padding" Value="6 0 10 0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#14000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#26000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <Button Style="{StaticResource AiMenuItem}" Click="AiMenuItem_Click" Command="{Binding CopyAiInstructionsCommand}" ToolTip="{x:Static loc:ScriptEditorStrings.AiInstructionsToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CreationOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource IconBrush}"/>
                                    <TextBlock Text="{x:Static loc:ScriptEditorStrings.AiInstructions}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AiMenuItem}" Click="AiMenuItem_Click" Command="{Binding CopyAiInstructionsWithScriptCommand}" ToolTip="{x:Static loc:ScriptEditorStrings.AiScriptAndErrorsToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16" VerticalAlignment="Center" Foreground="{StaticResource IconBrush}"/>
                                    <TextBlock Text="{x:Static loc:ScriptEditorStrings.AiScriptAndErrors}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator Height="1" Margin="0 4 0 2"/>
                            <!-- Applies to both items and to the icon. The list stays open on it (StaysOpen); the items close it themselves. -->
                            <CheckBox IsChecked="{Binding IsAiDetailed}" Height="26" Margin="6 0 10 0" Padding="4 0 0 0" VerticalContentAlignment="Center" FontSize="12"
                                      Content="{x:Static loc:ScriptEditorStrings.AiDetailed}"
                                      ToolTip="{x:Static loc:ScriptEditorStrings.AiDetailedToolTip}"/>
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ContextText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding TxtStatus}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240" MinHeight="80"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="5 5 5 5" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        Style="{StaticResource FramedTabControl}">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource FramedTabItem}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Grid Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static loc:ScriptEditorStrings.CloseTab}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{x:Static loc:ScriptEditorStrings.SaveAsMenu}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <!-- Only a tab saved to a file has one to show. -->
                                                <MenuItem Header="{x:Static loc:ScriptEditorStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <TextBlock Text="{Binding Header}" ToolTip="{Binding FilePath}" FontSize="14" FontWeight="DemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}"
                                                Padding="0" Margin="6 0 0 0" Width="14" Height="14" VerticalAlignment="Center" ToolTip="{x:Static loc:ScriptEditorStrings.Close}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <local:ScriptEditorHost Tab="{Binding}"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <console:ConsoleView Grid.Row="2" Margin="5" DataContext="{Binding Output}" WrapWidth="-1" IsViewMenu="True" HasPaneOpening="False"/>
        </Grid>
    </DockPanel>
</Window>