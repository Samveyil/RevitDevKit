<Window x:Class="RevitDevKit.UI.ScriptEditor.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitDevKit.UI.ScriptEditor"
        xmlns:console="clr-namespace:RevitDevKit.UI.Console"
        d:DataContext="{d:DesignInstance local:ScriptEditorVM}"
        mc:Ignorable="d"
        Title="Script Editor" WindowStartupLocation="CenterScreen"
        Height="800" Width="820" MinHeight="480" MinWidth="820">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/Theme.xaml" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveFileAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding Output.ClearCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="Скомпилировать и выполнить (F5 или Ctrl+Enter)" >
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Запустить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding RunWithDebuggerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="Запустить под отладчиком: подключить Visual Studio и остановиться на первой строке скрипта">
                <materialDesign:PackIcon Kind="BugPlayOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding NewTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Новая вкладка (Ctrl+N)">
                <materialDesign:PackIcon Kind="FileCodeOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0" Padding="0" Command="{Binding OpenFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Открыть .cs (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Padding="0" Command="{Binding SaveFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Сохранить (Ctrl+S)">
                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding SaveFileAsCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Сохранить как (Ctrl+Shift+S)">
                <materialDesign:PackIcon Kind="ContentSaveEditOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border BorderThickness="1" BorderBrush="{StaticResource AccentBrush}" CornerRadius="3" Margin="20 0">
                <materialDesign:PopupBox ToolTip="Вставить готовый пример в новую вкладку">
                    <materialDesign:PopupBox.ToggleContent>
                        <TextBlock Text="Примеры ▾" Margin="10 0 5 0" />
                    </materialDesign:PopupBox.ToggleContent>

                    <ItemsControl ItemsSource="{Binding CodeSamples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Command="{Binding DataContext.SampleSelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </materialDesign:PopupBox>
            </Border>

            <CheckBox VerticalAlignment="Bottom" Padding="2 0" Content="Автотранзакция" IsChecked="{Binding IsAutoTransaction}"
                      ToolTip="Обернуть выполнение в транзакцию. Выключите, если скрипт открывает транзакции сам."/>

            <CheckBox VerticalAlignment="Bottom" Padding="2 0" Content="Чистить консоль" Margin="8 0" IsChecked="{Binding IsClearOnRun}"
                      ToolTip="Очищать консоль перед каждым запуском"/>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ContextText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding TxtStatus}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240" MinHeight="80"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="5 0 5 5" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        Style="{StaticResource FramedTabControl}">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource FramedTabItem}">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Grid Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Закрыть вкладку" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Сохранить как…" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <!-- Only a tab saved to a file has one to show. -->
                                                <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFile}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <TextBlock Text="{Binding Header}" ToolTip="{Binding FilePath}" FontSize="14" FontWeight="DemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}"
                                                Padding="0" Margin="6 0 0 0" Width="14" Height="14" VerticalAlignment="Center" ToolTip="Закрыть"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <local:ScriptEditorHost Tab="{Binding}"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <console:ConsoleView Grid.Row="2" Margin="5" DataContext="{Binding Output}"/>
        </Grid>
    </DockPanel>
</Window>