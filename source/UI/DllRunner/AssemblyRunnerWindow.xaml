<Window x:Class="RevitDevKit.UI.DllRunner.AssemblyRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitDevKit.UI.DllRunner"
        d:DataContext="{d:DesignInstance local:AssemblyRunnerVM}"
        mc:Ignorable="d"
        Title="DLL Runner" WindowStartupLocation="CenterScreen"
        Height="720" Width="520" MinHeight="320" MinWidth="520">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Each tab has its own toolbar: 0 - commands, 1 - applications, 2 - startup. -->
            <Style x:Key="CommandsToolbar" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AppsToolbar" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StartupToolbar" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DependenciesToolbar" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!-- Red for what fails or may fail, orange for what works on someone else's or another copy. -->
            <Style x:Key="SeverityText" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                        <Setter Property="Foreground" Value="#C62828"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Minor">
                        <Setter Property="Foreground" Value="#B26A00"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SeverityIcon" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0 0 6 0"/>
                <Setter Property="Kind" Value="CheckCircleOutline"/>
                <Setter Property="Foreground" Value="Gray"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                        <Setter Property="Kind" Value="AlertOutline"/>
                        <Setter Property="Foreground" Value="#C62828"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Minor">
                        <Setter Property="Kind" Value="InformationOutline"/>
                        <Setter Property="Foreground" Value="#B26A00"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Rows of the Applications and Startup lists: a bold name and a small gray line under it, little padding. -->
            <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="4 2"/>
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="DemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="LineHeight" Value="15"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>

            <Style x:Key="RowDetails" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>
            <DataTemplate x:Key="TabHeader">
                <TextBlock Text="{Binding}" FontSize="14" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunHotkeyCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddHotkeyCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadHotkeyCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5" Style="{StaticResource CommandsToolbar}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="Выполнить выбранную команду (F5 или двойной щелчок)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Выполнить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding AddAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Добавить DLL (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding ReloadAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Обновить список команд DLL (Ctrl+R). Для любой DLL — правой кнопкой по ней">
                <materialDesign:PackIcon Kind="Refresh" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Показать в проводнике DLL">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding RemoveAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Убрать из списка DLL">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="Чистить консоль" Margin="20 0 0 0" IsChecked="{Binding IsClearOnRun}"
                      ToolTip="Очищать консоль перед каждым запуском"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5" Style="{StaticResource AppsToolbar}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Apps.ApplyCommand}"
                    ToolTip="Обновить кнопки на ленте по свежей сборке DLL (F5 или двойной щелчок)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Обновить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding Apps.AddAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Добавить собранную DLL и сразу обновить по ней ленту (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding Apps.RevertCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Вернуть как было: лента снова такая, как её создал .addin">
                <materialDesign:PackIcon Kind="Restore" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding Apps.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Показать в проводнике DLL">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding Apps.RemoveCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Вернуть ленту и убрать DLL из списка">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5" Style="{StaticResource StartupToolbar}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Startup.RefreshCommand}"
                    ToolTip="Перечитать папки надстроек (F5)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Обновить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding Startup.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Показать в проводнике .addin">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding Startup.OpenFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Открыть .addin в Блокноте (Ctrl+O)">
                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5" Style="{StaticResource DependenciesToolbar}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Dependencies.RefreshCommand}"
                    ToolTip="Проверить DLL надстроек этой версии Revit (F5)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Проверить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding Dependencies.CopyReportCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Копировать отчёт в markdown">
                <materialDesign:PackIcon Kind="ContentCopy" Width="22" Height="22" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding Dependencies.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Показать в проводнике выбранную DLL">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="Только расхождения" Margin="20 0 0 0" IsChecked="{Binding Dependencies.OnlyProblems}"
                      ToolTip="Снимите, чтобы видеть и DLL, одинаковые у нескольких надстроек"/>
        </StackPanel>

        <TabControl Margin="5 0 5 5" Style="{StaticResource FramedTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Команды" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4 2">
                            <Button DockPanel.Dock="Right" Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding CollapseAllCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Свернуть всё">
                                <materialDesign:PackIcon Kind="ArrowExpand" Width="22" Height="22" Foreground="{StaticResource IconBrush}"/>
                            </Button>

                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                                     materialDesign:HintAssist.Hint="Поиск" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                        </DockPanel>

                        <Grid>
                            <TreeView ItemsSource="{Binding Assemblies}" Margin="2">
                                <TreeView.Resources>
                                    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
                                        <Setter Property="Padding" Value="4 1"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>

                                    <HierarchicalDataTemplate DataType="{x:Type local:AssemblyNodeVM}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}" Background="Transparent"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                                    <MenuItem Header="Обновить список команд" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.ReloadAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="Убрать из списка" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.RemoveAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>

                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="{StaticResource AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="   — нет IExternalCommand" Foreground="Gray" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTargets}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <HierarchicalDataTemplate DataType="{x:Type local:NamespaceNodeVM}" ItemsSource="{Binding Targets}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="{StaticResource IconBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <DataTemplate DataType="{x:Type local:TargetNodeVM}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding TypeName}" Background="Transparent">
                                            <StackPanel.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                            </StackPanel.InputBindings>

                                            <materialDesign:PackIcon Kind="LanguageCsharp" Width="16" Height="16" Foreground="{StaticResource IconBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>

                            <TextBlock Text="Добавьте DLL кнопкой с папкой или Ctrl+O" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Assemblies.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Ничего не найдено" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNothingFound}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
            </TabItem>

            <TabItem Header="Приложения" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <Grid>
                    <ListBox ItemsSource="{Binding Apps.Items}" SelectedItem="{Binding Apps.SelectedItem}" Margin="2"
                             HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListBoxItem}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FilePath}" Background="Transparent"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.Apps.ApplyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                    </Grid.InputBindings>

                                    <Grid.ContextMenu>
                                        <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                            <MenuItem Header="Обновить" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.ApplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Вернуть как было" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RevertCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Убрать из списка" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <materialDesign:PackIcon Grid.RowSpan="2" Kind="PackageVariantClosed" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0 0 6 0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource RowDetails}" Margin="8 0 0 0" VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ApplicationsText}" Style="{StaticResource RowDetails}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Добавьте DLL с IExternalApplication кнопкой с папкой или Ctrl+O" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Apps.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Startup" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="2" Padding="8 4" CornerRadius="4" Background="#FFF4E5"
                            Visibility="{Binding Startup.IsRestartNeeded, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="Изменения применятся при следующем запуске Revit" Foreground="#8A4B00" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox ItemsSource="{Binding Startup.View}" SelectedItem="{Binding Startup.SelectedItem}" Margin="2"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CompactListBoxItem}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#0A000000" Padding="6 2">
                                                <DockPanel>
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Width="14" Height="14" Foreground="Gray"
                                                                             VerticalAlignment="Center" Margin="0 0 6 0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="AccountOutline"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Items[0].IsAllUsers}" Value="True">
                                                                        <Setter Property="Kind" Value="AccountMultipleOutline"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Text="{Binding Name}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                                <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.Startup.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Открыть .addin" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.Startup.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The box shows the file on disk: a rename that fails leaves it as it was. -->
                                        <CheckBox Grid.RowSpan="2" VerticalAlignment="Center" Margin="0 0 6 0"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanChange}"
                                                  Command="{Binding DataContext.Startup.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" ToolTip="Загружать при запуске Revit"/>

                                        <materialDesign:PackIcon Grid.Column="1" Grid.RowSpan="2" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0 0 6 0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="PackageVariantClosed"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Kind" Value="LockOutline"/>
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock Grid.Column="2" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Details}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowDetails}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="В папках надстроек этой версии Revit нет .addin" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Startup.Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Dependencies" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4 2">
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                                 VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding Dependencies.SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                                 materialDesign:HintAssist.Hint="Поиск по DLL или надстройке" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Dependencies.Status}" Style="{StaticResource RowDetails}" Margin="6 2"/>

                    <Grid>
                        <TreeView ItemsSource="{Binding Dependencies.Sections}" Margin="2" Grid.IsSharedSizeScope="True">
                            <TreeView.Resources>
                                <!-- Compact: a small expander (it is also the indent of each level) and no padding. -->
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2 0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="materialDesign:TreeViewAssist.ExpanderSize" Value="12"/>
                                </Style>

                                <HierarchicalDataTemplate DataType="{x:Type local:DependencySectionVM}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0 1">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="Gray"
                                                                 VerticalAlignment="Center" Margin="0 0 6 0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>

                                <HierarchicalDataTemplate DataType="{x:Type local:VersionGroupVM}" ItemsSource="{Binding Children}">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <materialDesign:PackIcon Grid.RowSpan="2" Style="{StaticResource SeverityIcon}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowTitle}" LineHeight="14"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource RowDetails}" LineHeight="12"/>
                                    </Grid>
                                </HierarchicalDataTemplate>

                                <!-- The add-ins of one DLL: the versions line up in a column across the whole tree. -->
                                <DataTemplate DataType="{x:Type local:DllCopyVM}">
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent"
                                          TextBlock.LineHeight="15" TextBlock.LineStackingStrategy="BlockLineHeight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DependencyOwner"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DependencyLoaded"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource SeverityText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="● загружена" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="8 0 0 0"
                                                   VerticalAlignment="Center" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource SeverityText}" FontFamily="Consolas"
                                                   Margin="12 0 0 0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock Text="Расхождений нет" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Dependencies.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
