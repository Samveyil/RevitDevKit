<Window x:Class="RevitDevKit.UI.DllRunner.AssemblyRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RevitDevKit.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitDevKit.UI.DllRunner"
        d:DataContext="{d:DesignInstance local:AssemblyRunnerVM}"
        mc:Ignorable="d"
        Title="Add-in Explorer" WindowStartupLocation="CenterScreen"
        Height="720" Width="580" MinHeight="320" MinWidth="580">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Shared/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MaterialDesign's tree keeps 8 left of each expander: the rows move 4 left, inside the tree, so the
                 expanders start 4 from the frame as the lists do. Moved inside, they are clipped by the scrolling area,
                 and the tree with its scroll bars stays within the frame. -->
            <ItemsPanelTemplate x:Key="TreeFromEdge">
                <StackPanel Margin="-4 0 0 0"/>
            </ItemsPanelTemplate>

            <!-- Red for what fails or may fail, orange for what works on someone else's or another copy. -->
            <Style x:Key="SeverityText" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                        <Setter Property="Foreground" Value="#C62828"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Minor">
                        <Setter Property="Foreground" Value="#B26A00"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SeverityIcon" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0 0 6 0"/>
                <Setter Property="Kind" Value="CheckCircleOutline"/>
                <Setter Property="Foreground" Value="Gray"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                        <Setter Property="Kind" Value="AlertOutline"/>
                        <Setter Property="Foreground" Value="#C62828"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="Minor">
                        <Setter Property="Kind" Value="InformationOutline"/>
                        <Setter Property="Foreground" Value="#B26A00"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Rows of the Applications and Startup lists: a bold name and a small gray line under it, little padding. -->
            <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="4 2"/>
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="DemiBold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="LineHeight" Value="15"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>

            <Style x:Key="RowDetails" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>
            <DataTemplate x:Key="TabHeader">
                <TextBlock Text="{Binding}" FontSize="14" FontWeight="DemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunHotkeyCommand}"/>
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding DebugHotkeyCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddHotkeyCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadHotkeyCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Each tab has its own toolbar, shown by SelectedTabIndex: 0 - commands, 1 - applications, 2 - startup, 3 - assemblies, 4 - dependencies. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="{x:Static loc:ExplorerStrings.RunToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ExplorerStrings.Run}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding RunWithDebuggerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="{x:Static loc:ExplorerStrings.DebugToolTip}">
                <materialDesign:PackIcon Kind="BugPlayOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding AddAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.AddDllToolTip}">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.ShowDllToolTip}">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Apps.ApplyCommand}"
                    ToolTip="{x:Static loc:ExplorerStrings.ApplyToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ExplorerStrings.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding Apps.AddAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.AddAppToolTip}">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Apps.RevertCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.RevertToolTip}">
                <materialDesign:PackIcon Kind="Restore" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Apps.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.ShowDllToolTip}">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Apps.RemoveCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.RemoveAppToolTip}">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Startup.RefreshCommand}"
                    ToolTip="{x:Static loc:ExplorerStrings.RescanToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ExplorerStrings.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding Startup.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.ShowAddinToolTip}">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Startup.OpenFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.OpenAddinToolTip}">
                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=4}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding Dependencies.RefreshCommand}"
                    ToolTip="{x:Static loc:ExplorerStrings.CheckToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ExplorerStrings.Check}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding Dependencies.SaveReportCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.SaveReportToolTip}">
                <materialDesign:PackIcon Kind="FileDocumentArrowRightOutline" Width="24" Height="24" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Dependencies.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.ShowSelectedDllToolTip}">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="{x:Static loc:ExplorerStrings.OnlyConflicts}" IsChecked="{Binding Dependencies.OnlyProblems}"
                      ToolTip="{x:Static loc:ExplorerStrings.OnlyConflictsToolTip}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=3}">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding LoadedAssemblies.RefreshCommand}"
                    ToolTip="{x:Static loc:ExplorerStrings.RefreshAssembliesToolTip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="{x:Static loc:ExplorerStrings.Refresh}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <Button Width="25" Height="25" Padding="0" Command="{Binding LoadedAssemblies.SaveListCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.SaveListToolTip}">
                <materialDesign:PackIcon Kind="FileDocumentArrowRightOutline" Width="24" Height="24" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Button Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding LoadedAssemblies.RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.ShowSelectedAssemblyToolTip}">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="{StaticResource IconBrush}"/>
            </Button>

            <Border Style="{StaticResource ToolbarSeparator}"/>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="{x:Static loc:ExplorerStrings.HideSystem}" IsChecked="{Binding LoadedAssemblies.HideSystem}"
                      ToolTip="{x:Static loc:ExplorerStrings.HideSystemToolTip}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=3}">
            <StatusBar>
                <StatusBarItem DockPanel.Dock="Right">
                    <TextBlock Text="{Binding LoadedAssemblies.Notice}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding LoadedAssemblies.Status}"/>
                </StatusBarItem>
            </StatusBar>
        </StackPanel>

        <!-- Dependencies' status bar, as the Script Editor has one: the check on the left, the last action on the right. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualsToVisibility}, ConverterParameter=4}">
            <StatusBar>
                <StatusBarItem DockPanel.Dock="Right">
                    <TextBlock Text="{Binding Dependencies.Notice}"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding Dependencies.Status}"/>
                </StatusBarItem>
            </StatusBar>
        </StackPanel>

        <TabControl Margin="5 5 5 5" Style="{StaticResource FramedTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Commands" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                    <!-- The tree comes first in focus order, as on Dependencies: a click on the tab does not land in the search box. -->
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <DockPanel DockPanel.Dock="Top" Margin="4 2.5 4 2">
                            <Button DockPanel.Dock="Right" Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding CollapseAllCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.CollapseAll}" TabIndex="2">
                                <materialDesign:PackIcon Kind="ArrowExpand" Width="22" Height="22" Foreground="{StaticResource IconBrush}"/>
                            </Button>

                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                                     materialDesign:HintAssist.Hint="{x:Static loc:ExplorerStrings.Search}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TabIndex="1"
                                     materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                        </DockPanel>

                        <Grid>
                            <TreeView ItemsSource="{Binding Assemblies}" ItemsPanel="{StaticResource TreeFromEdge}" TabIndex="0"
                                      PreviewMouseRightButtonDown="SelectOnRightClick">
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
                                        <Setter Property="Padding" Value="4 1"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>

                                    <HierarchicalDataTemplate DataType="{x:Type local:AssemblyNodeVM}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}" Background="Transparent"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                                    <MenuItem Header="{x:Static loc:ExplorerStrings.RefreshCommands}" InputGestureText="Ctrl+R" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.ReloadAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{x:Static loc:ExplorerStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="{x:Static loc:ExplorerStrings.RemoveFromList}" CommandParameter="{Binding}"
                                                              Command="{Binding PlacementTarget.Tag.RemoveAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>

                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Static loc:ExplorerStrings.NoCommands}" Foreground="Gray" VerticalAlignment="Center"
                                                       Visibility="{Binding HasTargets, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <HierarchicalDataTemplate DataType="{x:Type local:NamespaceNodeVM}" ItemsSource="{Binding Targets}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="{StaticResource IconBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <DataTemplate DataType="{x:Type local:TargetNodeVM}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding TypeName}" Background="Transparent">
                                            <StackPanel.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                            </StackPanel.InputBindings>

                                            <materialDesign:PackIcon Kind="LanguageCsharp" Width="16" Height="16" Foreground="{StaticResource IconBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>

                            <TextBlock Text="{x:Static loc:ExplorerStrings.AddDllHint}" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Assemblies.Count, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}"/>

                            <TextBlock Text="{x:Static loc:ExplorerStrings.NothingFound}" Foreground="Gray"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding IsNothingFound, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DockPanel>
            </TabItem>

            <TabItem Header="Applications" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <Grid>
                    <ListBox ItemsSource="{Binding Apps.Items}" SelectedItem="{Binding Apps.SelectedItem}" Margin="0"
                             HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListBoxItem}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FilePath}" Background="Transparent"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.Apps.ApplyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                    </Grid.InputBindings>

                                    <Grid.ContextMenu>
                                        <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                            <MenuItem Header="{x:Static loc:ExplorerStrings.RefreshMenu}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.ApplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{x:Static loc:ExplorerStrings.RevertMenu}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RevertCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{x:Static loc:ExplorerStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="{x:Static loc:ExplorerStrings.RemoveFromList}" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.Apps.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <materialDesign:PackIcon Grid.RowSpan="2" Kind="PackageVariantClosed" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0 0 6 0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BIMPlugins.PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>

                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource RowDetails}" Margin="8 0 0 0" VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ApplicationsText}" Style="{StaticResource RowDetails}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{x:Static loc:ExplorerStrings.AddAppHint}" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Apps.Items.Count, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Startup" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="2" Padding="8 4" CornerRadius="4" Background="#FFF4E5"
                            Visibility="{Binding Startup.IsRestartNeeded, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{StaticResource BIMPlugins.PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="{x:Static loc:ExplorerStrings.RestartNeeded}" Foreground="#8A4B00" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox ItemsSource="{Binding Startup.View}" SelectedItem="{Binding Startup.SelectedItem}" Margin="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CompactListBoxItem}">
                            <ListBox.GroupStyle>
                                <!-- A plain group: a header over its rows, no indent, so the rows line up with the other tabs'. -->
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <ContentPresenter/>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#0A000000" Padding="4 2">
                                                <DockPanel>
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Width="14" Height="14" Foreground="Gray"
                                                                             VerticalAlignment="Center" Margin="0 0 6 0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="AccountOutline"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Items[0].IsAllUsers}" Value="True">
                                                                        <Setter Property="Kind" Value="AccountMultipleOutline"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Text="{Binding Name}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                                <MenuItem Header="{x:Static loc:ExplorerStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.Startup.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{x:Static loc:ExplorerStrings.OpenAddinMenu}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.Startup.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The box shows the file on disk: a rename that fails leaves it as it was. -->
                                        <CheckBox Grid.RowSpan="2" VerticalAlignment="Center" Margin="0 0 6 0"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanChange}"
                                                  Command="{Binding DataContext.Startup.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" ToolTip="{x:Static loc:ExplorerStrings.LoadAtStartupToolTip}"/>

                                        <materialDesign:PackIcon Grid.Column="1" Grid.RowSpan="2" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0 0 6 0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="PackageVariantClosed"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BIMPlugins.PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Kind" Value="LockOutline"/>
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock Grid.Column="2" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Details}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowDetails}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{x:Static loc:ExplorerStrings.NoAddins}" Foreground="Gray"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Startup.Items.Count, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Assemblies" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <!-- The list comes first in focus order, as on Dependencies: a click on the tab does not land in the search box. -->
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <!-- As tall as the row with the collapse button on Commands and Dependencies: the box sits at the same height.
                         4 from the frame to each element: the magnifier on the left, the box on top (2.5 + half of 25 - 22), the button or the box on the right. -->
                    <DockPanel DockPanel.Dock="Top" Margin="4 2.5 4 2" MinHeight="25">
                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                                 VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding LoadedAssemblies.SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                                 materialDesign:HintAssist.Hint="{x:Static loc:ExplorerStrings.Search}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TabIndex="1"
                                 materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                    </DockPanel>

                    <Grid>
                        <ListBox ItemsSource="{Binding LoadedAssemblies.Items}" SelectedItem="{Binding LoadedAssemblies.SelectedItem}" Margin="0" TabIndex="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CompactListBoxItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.LoadedAssemblies.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        </Grid.InputBindings>
                                        <Grid.ContextMenu>
                                            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                                <MenuItem Header="{x:Static loc:ExplorerStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.LoadedAssemblies.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{x:Static loc:ExplorerStrings.CopyPath}" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.LoadedAssemblies.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Padded with spaces to the longest number in the list: a column only as wide as it needs. -->
                                        <TextBlock Grid.RowSpan="2" Text="{Binding Number}" FontFamily="Consolas" FontSize="11" Foreground="Gray"
                                                   VerticalAlignment="Center" Margin="0 0 6 0"/>

                                        <!-- Orange: the same name is loaded more than once. -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                            <Setter Property="Foreground" Value="#B26A00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Margin="8 0 0 0" FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                            <Setter Property="Foreground" Value="#B26A00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding Owner}" Style="{StaticResource RowDetails}" Margin="8 0 0 0"
                                                   VerticalAlignment="Bottom" MaxWidth="160"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Where}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowDetails}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInMemory}" Value="True">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{x:Static loc:ExplorerStrings.NothingFound}" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding LoadedAssemblies.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Dependencies" Style="{StaticResource FramedTabItem}" HeaderTemplate="{StaticResource TabHeader}">
                <!-- The tree comes first in focus order: opening the tab with a click puts the focus here, not in the search box. -->
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <DockPanel DockPanel.Dock="Top" Margin="4 2.5 4 2">
                        <Button DockPanel.Dock="Right" Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding Dependencies.CollapseAllCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" ToolTip="{x:Static loc:ExplorerStrings.CollapseAll}" TabIndex="2">
                            <materialDesign:PackIcon Kind="ArrowExpand" Width="22" Height="22" Foreground="{StaticResource IconBrush}"/>
                        </Button>

                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                                 VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding Dependencies.SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                                 materialDesign:HintAssist.Hint="{x:Static loc:ExplorerStrings.Search}" Style="{StaticResource MaterialDesignOutlinedTextBox}" TabIndex="1"
                                 materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                    </DockPanel>

                    <Grid>
                        <TreeView ItemsSource="{Binding Dependencies.Sections}" Grid.IsSharedSizeScope="True" TabIndex="0"
                                  ItemsPanel="{StaticResource TreeFromEdge}" PreviewMouseRightButtonDown="SelectOnRightClick">
                            <TreeView.Resources>
                                <!-- Compact: a small expander (it is also the indent of each level) and no padding. -->
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2 0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="materialDesign:TreeViewAssist.ExpanderSize" Value="12"/>
                                </Style>

                                <HierarchicalDataTemplate DataType="{x:Type local:DependencySectionVM}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0 1">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="Gray"
                                                                 VerticalAlignment="Center" Margin="0 0 6 0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>

                                <!-- The same menu on a DLL and on each add-in's copy of it. -->
                                <ContextMenu x:Key="DependencyMenu" x:Shared="False" materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                    <MenuItem Header="{x:Static loc:ExplorerStrings.ShowInExplorer}" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.Dependencies.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{x:Static loc:ExplorerStrings.CopyPath}" CommandParameter="{Binding}"
                                              Command="{Binding PlacementTarget.Tag.Dependencies.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>

                                <HierarchicalDataTemplate DataType="{x:Type local:VersionGroupVM}" ItemsSource="{Binding Children}">
                                    <Grid Background="Transparent" ContextMenu="{StaticResource DependencyMenu}" ToolTip="{Binding ToolTip}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <materialDesign:PackIcon Grid.RowSpan="2" Style="{StaticResource SeverityIcon}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowTitle}" LineHeight="14"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource RowDetails}" LineHeight="12"/>
                                    </Grid>
                                </HierarchicalDataTemplate>

                                <!-- The add-ins of one DLL: the versions line up in a column across the whole tree. -->
                                <DataTemplate DataType="{x:Type local:DllCopyVM}">
                                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent" ContextMenu="{StaticResource DependencyMenu}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                          TextBlock.LineHeight="15" TextBlock.LineStackingStrategy="BlockLineHeight">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.Dependencies.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DependencyOwner"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DependencyLoaded"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource SeverityText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static loc:ExplorerStrings.LoadedMark}" FontSize="11" Foreground="{StaticResource BIMPlugins.PrimaryBrush}" Margin="8 0 0 0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Style="{StaticResource SeverityText}" FontFamily="Consolas"
                                                   Margin="12 0 0 0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock Text="{x:Static loc:ExplorerStrings.NoConflicts}" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Dependencies.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
