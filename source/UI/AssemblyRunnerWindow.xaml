<Window x:Class="RevitScriptRunner.UI.AssemblyRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitScriptRunner.UI"
        d:DataContext="{d:DesignInstance local:AssemblyRunnerVM}"
        mc:Ignorable="d"
        Title="Script Runner — DLL" WindowStartupLocation="CenterScreen"
        Height="720" Width="520" MinHeight="320" MinWidth="520">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#f88518" SecondaryColor="#FF0052A5" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddAssemblyCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadAssemblyCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="Выполнить выбранную команду (F5 или двойной щелчок)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="#f88518"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Выполнить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding AddAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Добавить DLL (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding ReloadAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Обновить список команд DLL (Ctrl+R). Для любой DLL — правой кнопкой по ней">
                <materialDesign:PackIcon Kind="Refresh" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding RevealInExplorerCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Показать в проводнике DLL">
                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0 0 0" Padding="0" Command="{Binding RemoveAssemblyCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Убрать из списка DLL">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="Чистить консоль" Margin="20 0 0 0" IsChecked="{Binding IsClearOnRun}"
                      ToolTip="Очищать консоль перед каждым запуском"/>
        </StackPanel>

        <Border Margin="5 0 5 5" BorderThickness="1" BorderBrush="#f88518" CornerRadius="4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4 2">
                    <Button DockPanel.Dock="Right" Width="25" Height="25" Margin="8 0 0 0" Padding="0" Command="{Binding CollapseAllCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Свернуть всё">
                        <materialDesign:PackIcon Kind="ArrowExpand" Width="22" Height="22" Foreground="#CC000000"/>
                    </Button>

                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="20" Height="20" Foreground="Gray"
                                             VerticalAlignment="Center" Margin="0 0 6 0"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="5 2"
                             materialDesign:HintAssist.Hint="Поиск" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.HasClearButton="True" materialDesign:HintAssist.IsFloating="False"/>
                </DockPanel>

                <Grid>
                    <TreeView ItemsSource="{Binding Assemblies}" Margin="2">
                        <TreeView.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
                                <Setter Property="Padding" Value="4 1"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>

                            <HierarchicalDataTemplate DataType="{x:Type local:AssemblyNodeVM}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}" Background="Transparent"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                                            <MenuItem Header="Обновить список команд" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.ReloadAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Убрать из списка" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.RemoveAssemblyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="#f88518"
                                                             VerticalAlignment="Center" Margin="0 0 6 0"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="   — нет IExternalCommand" Foreground="Gray" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTargets}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type local:NamespaceNodeVM}" ItemsSource="{Binding Targets}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16" Foreground="#CC000000"
                                                             VerticalAlignment="Center" Margin="0 0 6 0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:TargetNodeVM}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding TypeName}" Background="Transparent">
                                    <StackPanel.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    </StackPanel.InputBindings>

                                    <materialDesign:PackIcon Kind="LanguageCsharp" Width="16" Height="16" Foreground="#CC000000"
                                                             VerticalAlignment="Center" Margin="0 0 6 0"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TextBlock Text="Добавьте DLL кнопкой с папкой или Ctrl+O" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Assemblies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Ничего не найдено" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNothingFound}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>