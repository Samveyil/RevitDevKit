<Window x:Class="RevitScriptRunner.UI.RunnerWindowGPT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Script Runner"
        Height="800" Width="1200"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <!--
        Оформления здесь намеренно нет: ни стилей, ни шаблонов, ни цветов.
        Всё на стандартных контролах WPF. Тему добавим отдельно.
    -->

    <DockPanel>

        <!-- ================= панель инструментов ================= -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button x:Name="BtnRun" Click="OnRun" Padding="10,3" Margin="0,0,8,0"
                    ToolTip="Скомпилировать и выполнить (F5 или Ctrl+Enter)">Запустить (F5)</Button>

            <Button Click="OnNewTab"   Padding="8,3" Margin="0,0,2,0" ToolTip="Новая вкладка (Ctrl+N)">Новый</Button>
            <Button Click="OnOpenFile" Padding="8,3" Margin="0,0,2,0" ToolTip="Открыть .cs (Ctrl+O)">Открыть…</Button>
            <Button Click="OnSaveFile" Padding="8,3" Margin="0,0,8,0" ToolTip="Сохранить (Ctrl+S)">Сохранить</Button>

            <TextBlock Text="Примеры:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="CmbSamples" Width="220" VerticalAlignment="Center" Margin="0,0,8,0"
                      SelectionChanged="OnSampleSelected" ToolTip="Вставить готовый пример в новую вкладку"/>

            <CheckBox x:Name="ChkAutoTransaction" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Обернуть выполнение в транзакцию. Выключите, если скрипт открывает транзакции сам.">
                Автотранзакция
            </CheckBox>

            <CheckBox x:Name="ChkClearOnRun" IsChecked="True" VerticalAlignment="Center"
                      ToolTip="Очищать консоль перед каждым запуском">Чистить консоль</CheckBox>
        </StackPanel>

        <!-- ================= строка состояния ================= -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Готово"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtContext"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ================= рабочая область + консоль ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240" MinHeight="80"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="4,0,4,0">

                <TabItem Header="C# скрипт">
                    <TabControl x:Name="ScriptTabs"/>
                </TabItem>

                <TabItem Header="Внешние DLL">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <Button Click="OnAddAssembly" Padding="8,3" Margin="0,0,2,0"
                                    ToolTip="Выбрать .dll и показать всё, что в ней можно запустить">Добавить DLL…</Button>
                            <Button Click="OnReloadAssembly" Padding="8,3" Margin="0,0,2,0"
                                    ToolTip="Перечитать DLL с диска после пересборки">Перезагрузить</Button>
                            <Button Click="OnRemoveAssembly" Padding="8,3" Margin="0,0,8,0"
                                    ToolTip="Убрать из списка">Убрать</Button>
                            <Button Click="OnRunTarget" Padding="10,3"
                                    ToolTip="Выполнить выбранную команду или метод">Выполнить выбранное</Button>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Margin="4" TextWrapping="Wrap"
                                   Text="DLL грузится теневой копией — исходный файл не блокируется, его можно пересобирать. После пересборки нажмите «Перезагрузить»."/>

                        <TextBlock DockPanel.Dock="Bottom" x:Name="TxtUnloadHint" Margin="4,0"/>

                        <TreeView x:Name="AssemblyTree" Margin="4,0,4,4"
                                  MouseDoubleClick="OnTreeDoubleClick"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Row="2" Margin="4,0,4,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Консоль" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Click="OnClearConsole" Padding="8,2" Margin="0,0,2,0"
                            ToolTip="Очистить консоль (Ctrl+L)">Очистить</Button>
                    <Button Click="OnCopyConsole" Padding="8,2" Margin="0,0,12,0"
                            ToolTip="Скопировать весь вывод в буфер обмена">Копировать</Button>

                    <CheckBox x:Name="ChkAutoScroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0">Автопрокрутка</CheckBox>
                    <CheckBox x:Name="ChkTimestamps" VerticalAlignment="Center" Margin="0,0,10,0">Время</CheckBox>
                    <CheckBox x:Name="ChkShowDebug" IsChecked="True" VerticalAlignment="Center">Стек вызовов</CheckBox>
                </StackPanel>

                <RichTextBox x:Name="Console" IsReadOnly="True" IsDocumentEnabled="True"
                             FontFamily="Consolas" Margin="0,0,0,4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
