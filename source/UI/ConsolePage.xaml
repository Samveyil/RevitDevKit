<Page x:Class="RevitDevKit.UI.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:RevitDevKit.UI"
      Title="DevKit Console" Background="White">

    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/RevitDevKit;component/UI/Theme.xaml" />
    </Page.Resources>

    <Page.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCommand}"/>
    </Page.InputBindings>

    <local:ConsoleView Margin="5" IsPersistent="True"/>
</Page>
