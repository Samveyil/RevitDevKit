<Window x:Class="RevitScriptRunner.UI.RunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RevitScriptRunner.UI"
        d:DataContext="{d:DesignInstance local:RunnerVM}"
        mc:Ignorable="d"
        Title="Script Runner" WindowStartupLocation="CenterScreen"
        Height="800" Width="1200" MinHeight="480" MinWidth="820">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#f88518" SecondaryColor="#FF0052A5" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding RunCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearConsoleCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Style="{StaticResource MaterialDesignPaperButton}" Padding="8 0" Height="25" Command="{Binding RunCommand}"
                    ToolTip="Скомпилировать и выполнить (F5 или Ctrl+Enter)" >
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Width="20" Height="20" Foreground="#f88518"
                                             VerticalAlignment="Center" Padding="0" Margin="-5 0 2 0"/>
                    <TextBlock Text="Запустить (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding NewTabCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Новая вкладка (Ctrl+N)">
                <materialDesign:PackIcon Kind="FileCodeOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Button Width="25" Height="25" Margin="10 0" Padding="0" Command="{Binding OpenFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Открыть .cs (Ctrl+O)">
                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Button Width="25" Height="25" Padding="0" Command="{Binding SaveFileCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Сохранить (Ctrl+S)">
                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="25" Height="25" Foreground="#CC000000"/>
            </Button>

            <Border BorderThickness="1" BorderBrush="#f88518" CornerRadius="3" Margin="20 0">
                <materialDesign:PopupBox ToolTip="Вставить готовый пример в новую вкладку">
                    <materialDesign:PopupBox.ToggleContent>
                        <TextBlock Text="Примеры ▾" Margin="10 0 5 0" />
                    </materialDesign:PopupBox.ToggleContent>
                    <ItemsControl ItemsSource="{Binding CodeSamples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Command="{Binding DataContext.SampleSelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </materialDesign:PopupBox>
            </Border>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="Автотранзакция" IsChecked="{Binding IsAutoTransaction}"
                      ToolTip="Обернуть выполнение в транзакцию. Выключите, если скрипт открывает транзакции сам."/>

            <CheckBox VerticalAlignment="Center" Padding="2 0" Content="Чистить консоль" Margin="8 0" IsChecked="{Binding IsClearOnRun}"
                      ToolTip="Очищать консоль перед каждым запуском"/>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ContextText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding TxtStatus}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240" MinHeight="80"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="5 0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">

                <!-- Рамка вокруг редактора, «вырастающая» из выбранной вкладки.
                     Контур выбранной вкладки и рамки рисует TabFrame одной линией,
                     поэтому скругления совпадают. Margin -2 у панели выравнивает
                     крайние вкладки по краям рамки. -->
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Rows="1" IsItemsHost="True" Margin="-2 0"/>

                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="1"/>

                            <local:TabFrame Grid.RowSpan="2" Stroke="#f88518" Radius="4"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Margin" Value="2 4 2 1"/>
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" BorderThickness="1" CornerRadius="4" Padding="5" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Контур выбранной вкладки рисует TabFrame; толщину оставляем,
                                             чтобы заголовок не сдвигался при выборе. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <!-- ContextMenu не в визуальном дереве: VM окна передаём ему через Tag. -->
                                    <Grid Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Закрыть вкладку" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Показать в проводнике" CommandParameter="{Binding}"
                                                          Command="{Binding PlacementTarget.Tag.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <TextBlock Text="{Binding Header}" ToolTip="{Binding FilePath}" FontSize="14" FontWeight="DemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}"
                                                Padding="0" Margin="6 0 0 0" Width="14" Height="14" VerticalAlignment="Center" ToolTip="Закрыть"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <!-- Выбранная вкладка опускается на 1 px и встаёт на рамку,
                                 остальные стоят над её верхней линией. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Margin" Value="2 4 2 0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <local:ScriptEditorHost Tab="{Binding}"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Row="2" Margin="5">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock Text="Консоль" VerticalAlignment="Center"/>

                    <Button Width="25" Height="25" Margin="15 0 0 0" Padding="0" Command="{Binding ClearConsoleCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Очистить консоль (Ctrl+L)">
                        <materialDesign:PackIcon Kind="Broom" Width="25" Height="25" Foreground="#CC000000"/>
                    </Button>

                    <Button Width="22" Height="22" Margin="10 0" Padding="0" VerticalAlignment="Center" Click="OnCopyConsole"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Скопировать весь вывод в буфер обмена">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="22" Height="22" Foreground="#CC000000"/>
                    </Button>

                    <CheckBox Content="Автопрокрутка" VerticalAlignment="Center" Margin="15 0 0 0" Padding="2 0" IsChecked="{Binding IsAutoScroll}"/>
                    <CheckBox Content="Время" VerticalAlignment="Center" Margin="10 0" Padding="2 0" IsChecked="{Binding IsTimestamps}"/>
                    <CheckBox Content="Стек вызовов" VerticalAlignment="Center" Padding="2 0" IsChecked="{Binding IsShowDebug}"/>
                </StackPanel>

                <RichTextBox x:Name="Console" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Consolas" Margin="0 2 0 0"
                             Style="{StaticResource MaterialDesignOutlinedRichTextBox}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>