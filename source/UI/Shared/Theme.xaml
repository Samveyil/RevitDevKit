<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:shared="clr-namespace:RevitDevKit.UI.Shared">

    <ResourceDictionary.MergedDictionaries>
        <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#F88518" SecondaryColor="#FF0052A5" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="AccentBrush" Color="#F88518" />
    <SolidColorBrush x:Key="IconBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="SelectedTabBrush" Color="#0F000000" />

    <!-- A thin line between groups of a toolbar, 8 from the controls on each side. Within a group buttons stand
         8 apart and checkboxes 12, counted from the edges of the controls, in every window. -->
    <Style x:Key="ToolbarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="8 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#33000000"/>
    </Style>

    <Style x:Key="FramedTabControl" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Rows="1" IsItemsHost="True" Margin="-2 0"/>

                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="1"/>

                        <shared:TabFrame Grid.RowSpan="2" Stroke="{StaticResource AccentBrush}" Radius="4"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No margin on top: the gap above the tabs is the toolbar's and the tab control's, 10 in every window. -->
    <Style x:Key="FramedTabItem" TargetType="TabItem">
        <Setter Property="Margin" Value="2 0 2 1"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" BorderThickness="1" CornerRadius="4" Padding="5" Background="Transparent"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="TabBorder" Property="CornerRadius" Value="4 4 0 0"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedTabBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Margin" Value="2 0 2 0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
